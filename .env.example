UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
# ALLOWED_ORIGINS=http://localhost:8000,https://panel.example.com
# CORS_ALLOW_CREDENTIALS=True

## We highly recommend add admin using `nexuspanel-cli` and do not use
## the following variables which is somehow hard codded infrmation.
# SUDO_USERNAME = "admin"
# SUDO_PASSWORD = "admin"

# UVICORN_UDS: "/run/nexuspanel.socket"
# UVICORN_SSL_CERTFILE = "/var/lib/nexuspanel/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE = "/var/lib/nexuspanel/certs/example.com/key.pem"
# UVICORN_SSL_CA_TYPE = "public"

# DASHBOARD_PATH = "/dashboard/"

# XRAY_JSON = "xray_config.json"
# XRAY_SUBSCRIPTION_URL_PREFIX = "https://example.com"
# XRAY_SUBSCRIPTION_PATH = "sub"
# XRAY_EXECUTABLE_PATH = "/usr/local/bin/xray"
# XRAY_ASSETS_PATH = "/usr/local/share/xray"
# XRAY_EXCLUDE_INBOUND_TAGS = "INBOUND_X INBOUND_Y"
# XRAY_FALLBACKS_INBOUND_TAG = "INBOUND_X"


# TELEGRAM_API_TOKEN = 123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# TELEGRAM_ADMIN_ID = 987654321, 123456789
# TELEGRAM_LOGGER_CHANNEL_ID = -1234567890123
# TELEGRAM_DEFAULT_VLESS_FLOW = "xtls-rprx-vision"
# TELEGRAM_PROXY_URL = "http://localhost:8080"

# DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/xxxxxxx"

# CUSTOM_TEMPLATES_DIRECTORY="/var/lib/nexuspanel/templates/"
# CLASH_SUBSCRIPTION_TEMPLATE="clash/my-custom-template.yml"
# SUBSCRIPTION_PAGE_TEMPLATE="subscription/index.html"
# HOME_PAGE_TEMPLATE="home/index.html"

# V2RAY_SUBSCRIPTION_TEMPLATE="v2ray/default.json"
# V2RAY_SETTINGS_TEMPLATE="v2ray/settings.json"

# SINGBOX_SUBSCRIPTION_TEMPLATE="singbox/default.json"
# SINGBOX_SETTINGS_TEMPLATE="singbox/settings.json"

# MUX_TEMPLATE="mux/default.json"

## Enable JSON config for compatible clients to use mux, fragment, etc. Default False.
# USE_CUSTOM_JSON_DEFAULT=True
## Your preferred config type for different clients
## If USE_CUSTOM_JSON_DEFAULT is set True, all following programs will use the JSON config
# USE_CUSTOM_JSON_FOR_V2RAYN=False
# USE_CUSTOM_JSON_FOR_V2RAYNG=True
# USE_CUSTOM_JSON_FOR_STREISAND=False
# USE_CUSTOM_JSON_FOR_HAPP=False

## Set headers for subscription
# SUB_PROFILE_TITLE = "Susbcription"
# SUB_SUPPORT_URL = "https://t.me/support"
# SUB_UPDATE_INTERVAL = "12"

## External config to import into v2ray format subscription
# EXTERNAL_CONFIG = "config://..."

# SQLALCHEMY_DATABASE_URL = "sqlite:///db.sqlite3"
## PostgreSQL (recommended for production / HA / multi-tenant):
# SQLALCHEMY_DATABASE_URL = "postgresql://nexuspanel:password@127.0.0.1:5432/nexuspanel"
## MySQL / MariaDB:
# SQLALCHEMY_DATABASE_URL = "mysql+pymysql://nexuspanel:password@127.0.0.1:3306/nexuspanel"
# SQLALCHEMY_POOL_SIZE = 10
# SQLIALCHEMY_MAX_OVERFLOW = 30

## Redis URL for the event bus / shared cache. Required for High Availability
## (multiple panels). Leave empty for single-instance in-process mode.
# REDIS_URL = "redis://127.0.0.1:6379/0"

## Event audit-log retention (days). <= 0 keeps events forever.
# EVENTS_RETENTION_DAYS = 30

## Structured JSON logging (recommended with log aggregation).
# LOG_JSON = False

## Static token for scraping the Prometheus /api/metrics endpoint.
# METRICS_TOKEN = "a-long-random-token"

## Backup & disaster recovery
# BACKUP_DIR = "/var/lib/nexuspanel/backups"
# BACKUP_INTERVAL_HOURS = 6
# BACKUP_RETENTION_COUNT = 7
# BACKUP_INCLUDE_ENV = False

## Cluster / reliability (phase 2)
## Shared token allowing nodes to self-register via POST /api/node/bootstrap.
# NODE_BOOTSTRAP_TOKEN = "a-long-random-token"
# NODE_CONTROL_SECRET = "same-on-panel-and-node-env"
# NODE_SSL_VERIFY = False
# LOGIN_MAX_ATTEMPTS = 10
# LOGIN_MAX_WINDOW_SECONDS = 900
# PROVISIONING_SSH_STRICT_HOST_KEY = True
# NODE_BOOTSTRAP_MAX_ATTEMPTS = 20
# SUDO_PASSWORD_HASH = "$2b$12$..."  # bcrypt hash; preferred over SUDO_PASSWORD
# REDIS_PASSWORD = "change-me"
# REDIS_URL=redis://:change-me@127.0.0.1:6379/0
## Public address nodes use to reach this panel (host:port). Set by installer.
# PANEL_PUBLIC_ADDRESS = "203.0.113.1:8000"
## Docker image for SSH node provisioning (build: docker build -t nexuspanel/node:latest ./node)
# NODE_AGENT_IMAGE = "nexuspanel/node:latest"
# NODE_PROVISION_SSH_TIMEOUT = 20
## Failover detector (0 disables). Marks nodes down after N seconds in error.
# CLUSTER_FAILOVER_CHECK_INTERVAL = 30
# CLUSTER_NODE_DOWN_SECONDS = 180
# CLUSTER_AUTO_DISABLE_DOWN_NODES = False

## OpenTelemetry tracing (phase 2)
# OTEL_ENABLED = False
# OTEL_EXPORTER_OTLP_ENDPOINT = "http://127.0.0.1:4317"
# OTEL_SERVICE_NAME = "nexuspanel"

## High availability (phase 4) — only the elected leader runs singleton jobs.
## Requires REDIS_URL; without it the single instance is always the leader.
# HA_ENABLED = False
# HA_INSTANCE_ID = ""        # defaults to hostname:pid
# HA_LEADER_TTL = 15

## Smart routing (phase 4): latency | region | load | round_robin
## (toggle the 'smart_routing' feature flag to expose /api/routing)
# ROUTING_STRATEGY = "latency"

## Traffic intelligence (phase 5) — background scan interval in seconds (0 = off).
## API endpoints still work on-demand; toggle the 'traffic_intelligence' flag.
# INTELLIGENCE_SCAN_INTERVAL = 0
# INTELLIGENCE_HEAVY_FACTOR = 3.0
# INTELLIGENCE_EXHAUSTION_WINDOW_HOURS = 48
# INTELLIGENCE_NODE_LATENCY_MS = 500
## Plugin marketplace: toggle the 'plugin_marketplace' feature flag to expose /api/marketplace

## Custom text for STATUS_TEXT variable
# ACTIVE_STATUS_TEXT = "Active"
# EXPIRED_STATUS_TEXT = "Expired"
# LIMITED_STATUS_TEXT = "Limited"
# DISABLED_STATUS_TEXT = "Disabled"
# ONHOLD_STATUS_TEXT = "On-Hold"

### Use negative values to disable auto-delete by default
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

## Customize all notifications
# NOTIFY_STATUS_CHANGE = True
# NOTIFY_USER_CREATED = True
# NOTIFY_USER_UPDATED = True
# NOTIFY_USER_DELETED = True
# NOTIFY_USER_DATA_USED_RESET = True
# NOTIFY_USER_SUB_REVOKED = True
# NOTIFY_IF_DATA_USAGE_PERCENT_REACHED = True
# NOTIFY_IF_DAYS_LEFT_REACHED = True
# NOTIFY_LOGIN = True

## Whitelist of IPs/hosts to disable login notifications
# LOGIN_NOTIFY_WHITE_LIST = '1.1.1.1,127.0.0.1'

### for developers
# DOCS=True
# DEBUG=True

# If You Want To Send Webhook To Multiple Server Add Multi Address
# WEBHOOK_ADDRESS = "http://127.0.0.1:9000/,http://127.0.0.1:9001/"
# WEBHOOK_SECRET = "something-very-very-secret"
# NOTIFY_DAYS_LEFT=3,7
# NOTIFY_REACHED_USAGE_PERCENT=80,90

# VITE_BASE_API="https://example.com/api/"
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440

# JOB_CORE_HEALTH_CHECK_INTERVAL = 10
# JOB_RECORD_NODE_USAGES_INTERVAL = 30
# JOB_RECORD_USER_USAGES_INTERVAL = 10
# JOB_REVIEW_USERS_INTERVAL = 10
# JOB_SEND_NOTIFICATIONS_INTERVAL = 30