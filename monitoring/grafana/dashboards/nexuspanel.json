{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "NexusPanel Overview",
  "tags": ["nexuspanel"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Online users (24h)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "nexuspanel_online_users", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active users",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "nexuspanel_users{status=\"active\"}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connected nodes",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(nexuspanel_node_connected)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Users by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "nexuspanel_users", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Total bandwidth (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "nexuspanel_bandwidth_bytes_total", "legendFormat": "{{direction}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-node bandwidth (bytes)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        { "expr": "nexuspanel_node_bandwidth_bytes_total", "legendFormat": "{{name}} {{direction}}", "refId": "A" }
      ]
    }
  ]
}
